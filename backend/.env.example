# Server Port (Render provides PORT automatically, or specify custom port)
# PORT=5000

# Hosted PostgreSQL Database Connection URL (e.g. Render PostgreSQL, Supabase, Neon, Railway)
# DATABASE_URL="postgresql://username:password@hostname:5432/database_name?sslmode=require"

# JWT Secret Key for signing authentication tokens
# JWT_SECRET="your_jwt_secret_key_here"

# Optional: Restrict CORS origin in production (defaults to '*' if omitted)
# FRONTEND_URL="https://your-frontend.vercel.app"
