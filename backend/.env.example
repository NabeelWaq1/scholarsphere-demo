# Server Port
PORT=5000

# Database Connection URL:
# For local SQLite development (default):
DATABASE_URL="file:./dev.db"

# For hosted PostgreSQL in production (Supabase, Neon, Render, Railway, etc.):
# DATABASE_URL="postgresql://username:password@hostname:5432/database_name?sslmode=require"

# JWT Secret Key for authentication
JWT_SECRET="your_secure_jwt_secret_key_change_in_production"

# Optional: Restrict CORS origin in production (defaults to '*' if omitted)
# FRONTEND_URL="https://your-frontend.vercel.app"
